@startuml sequence-password-reset
' Sequence diagram: forgot password -> reset password.
' Matches apps/api/src/routes/auth.ts (forgot-password, reset-password).
' Render at https://www.plantuml.com/plantuml or with the VS Code PlantUML extension.
title Password recovery: forgot and reset

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign left

actor Player
participant "Web / Mobile app" as App
participant "Express API" as API
database "MongoDB" as DB
participant "Email service\n(Resend)" as Mail

== Request a reset link ==
Player -> App : Tap "Forgot password", enter email
App -> API : POST /api/auth/forgot-password { email }
API -> DB : users.findOne({ email: lowercase })
opt user exists
  API -> DB : tokens.deleteMany({ userId, type: "reset" })
  API -> API : createRawToken(), SHA-256 hash it
  API -> DB : tokens.insertOne({ userId, type: "reset",\ntokenHash, expiresAt: now + 1h })
  API -> Mail : Send link https://DOMAIN/reset-password?token=RAW_TOKEN
end
API --> App : 200 { message: "If that email address is in\nour database, we have sent a reset link." }
note right of API : Same 200 whether or not the account exists,\nso nobody can probe for registered emails.
App --> Player : "Check your inbox"

== Choose a new password ==
Mail -> Player : Password reset email
Player -> App : Open link (web page /reset-password?token=...)
Player -> App : Enter new password
App -> API : POST /api/auth/reset-password { token, password }
alt token or password missing, or password < 8 chars
  API --> App : 400 { error }
  App --> Player : Show error
else input ok
  API -> DB : tokens.findOne({ type: "reset",\ntokenHash: hash(token), expiresAt > now })
  alt token valid
    DB --> API : token document
    API -> API : bcrypt.hash(password, 10)
    API -> DB : users.updateOne({ passwordHash })
    API -> DB : tokens.deleteMany({ userId, type: "reset" })
    API --> App : 200 { message: "Password reset successfully" }
    App --> Player : "Password updated, log in"
  else missing, already used or expired
    DB --> API : null
    API --> App : 400 { error: "Invalid or expired\npassword reset token" }
    App --> Player : Offer to request a new link
  end
end
@enduml
